<Window x:Class="InstAnalytics.AutoCleanFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InstAnalytics Auto-Clean"
        Width="290" Height="210"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="#F01A1A2E"
            BorderBrush="#80FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18,14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <TextBlock x:Name="FloatHeaderText"
                       Text="🧹 Auto-Clean in corso…"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#EAEAEA"
                       Margin="0,0,0,10"/>

            <!-- Progress panel -->
            <StackPanel x:Name="FloatProgressPanel">
                <TextBlock x:Name="FloatProgressText"
                           FontFamily="Segoe UI"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#E94560"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <ProgressBar x:Name="FloatProgressBar"
                             Minimum="0" Maximum="100"
                             Height="6"
                             BorderThickness="0"
                             Foreground="#4ECCA3"
                             Background="#2A2A3E"
                             Margin="0,0,0,10"/>

                <TextBlock x:Name="FloatUserText"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,3"/>

                <TextBlock x:Name="FloatStatusText"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#A0A0A0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <Button x:Name="FloatCancelBtn"
                        Content="Annulla"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#EAEAEA"
                        Background="#2A2A3E"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="1"
                        Padding="0,7"
                        Cursor="Hand"
                        Click="FloatCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Done panel -->
            <StackPanel x:Name="FloatDonePanel" Visibility="Collapsed">
                <TextBlock x:Name="FloatDoneSummaryText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#EAEAEA"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           LineHeight="20"
                           Margin="0,0,0,14"/>

                <Button x:Name="FloatCloseBtn"
                        Content="Chiudi"
                        FontFamily="Segoe UI"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="#E94560"
                        BorderThickness="0"
                        Padding="0,7"
                        Cursor="Hand"
                        Click="FloatClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
